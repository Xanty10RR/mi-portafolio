<header
  class="fixed top-0 left-0 w-full bg-black/90 backdrop-blur-lg z-30 border-b border-white/10"
>
  <div
    class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8 h-24"
  >
    <!-- Logo / Título (con whitespace-nowrap para evitar que se baje de línea) -->
    <a href="/#top" class="flex items-center">
      <span
        class="text-lg sm:text-xl lg:text-2xl font-bold text-white tracking-wide whitespace-nowrap"
      >
        Bienvenid@ a mi Portafolio
      </span>
    </a>

    <!-- Botón Hamburguesa aparece en pantallas medianas y pequeñas si no alcanza el espacio -->
    <button
      id="menu-btn"
      type="button"
      class="inline-flex items-center p-2 w-10 h-10 justify-center text-white rounded-lg lg:hidden hover:bg-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-500"
      aria-controls="navbar-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Abrir menú principal</span>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 17 14">
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 1h15M1 7h15M1 13h15"
        >
        </path>
      </svg>
    </button>

    <!-- Menú  en pantallas grandes -->
    <nav class="hidden lg:block" id="navbar-menu">
      <ul
        class="font-medium flex flex-col lg:flex-row lg:space-x-6 xl:space-x-8 items-center"
      >
        <li>
          <a
            class="navegacion transition-colors text-sm xl:text-base py-2"
            href="/#top">Inicio</a>
        </li>
        <li>
          <a
            class="navegacion transition-colors text-sm xl:text-base py-2"
            href="/#experiencia">Experiencia</a>
        </li>
        <li>
          <a
            class="navegacion transition-colors text-sm xl:text-base py-2"
            href="/#proyectos">Proyectos</a>
        </li>
        <li>
          <a
            class="navegacion transition-colors text-sm xl:text-base py-2"
            href="/#habilidades">Habilidades</a>
        </li>
        <li>
          <a
            class="navegacion transition-colors text-sm xl:text-base py-2"
            href="/#sobre-mi">Sobre mí</a>
        </li>
        <li>
          <a
            class="navegacion transition-colors text-sm xl:text-base py-2"
            href="/#contacto">Contáctame</a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Menú desplegable al hacer clic en el botón en pantallas pequeñas y medianas -->
  <div
    id="mobile-menu"
    class="mobile-menu flex flex-col text-center absolute top-full left-0 w-full bg-black/95 backdrop-blur-xl border-b border-white/10 shadow-2xl px-6 py-4 items-center"
  >
    <ul class="flex flex-col space-y-4 font-medium">
      <li><a class="block navegacion py-1" href="/#top">Inicio</a></li>
      <li>
        <a class="block navegacion py-1 w-fit" href="/#experiencia"
          >Experiencia</a>
      </li>
      <li>
        <a class="block navegacion py-1 w-fit" href="/#proyectos">Proyectos</a>
      </li>
      <li>
        <a class="block navegacion py-1 w-fit" href="/#habilidades"
          >Habilidades</a>
      </li>
      <li>
        <a class="block navegacion py-1 w-fit" href="/#sobre-mi">Sobre mí</a>
      </li>
      <li>
        <a class="block navegacion py-1 w-fit" href="/#contacto">Contáctame</a>
      </li>
    </ul>
  </div>
</header>

<div id="barra" class="fixed top-0 left-0"></div>

<style>
  .mobile-menu {
    display: none;
  }

  .mobile-menu.is-open {
    display: flex;
  }
</style>

<script>
  import.meta;
  document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (menuBtn && mobileMenu) {
      const navLinks = mobileMenu.querySelectorAll("a");

      menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("is-open");
        const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
        menuBtn.setAttribute("aria-expanded", isExpanded ? "false" : "true");
      });

      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.remove("is-open");
          menuBtn.setAttribute("aria-expanded", "false");
        });
      });
    }
  });
</script>
